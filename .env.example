# .env.example – configuration placeholders for MEMORA deployment (Render)
# ---------------------------------------------------------------
# FastAPI backend configuration
MEMORA_DB_URL=postgresql://username:password@hostname:5432/memora_db
MEMORA_SECRET_KEY=your-secret-key-32byteshex

# Rate limiting configuration (defaults)
MEMORA_RATE_LIMIT_WINDOW=60   # seconds
MEMORA_RATE_LIMIT_MAX=30      # max requests per window per user/IP

# NVIDIA LLM Provider (OpenAI compatible endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter fallback (optional)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=or-xxxxxxxxxxxxxxxxxxxx

# Misc settings
MEMORA_MAX_QUERY_LENGTH=5000
MEMORA_DEMO_MODE=false

# Render environment variables (auto‑injected by Render)
RENDER_SERVICE_URL=https://your‑service‑on‑render.com
RENDER_GIT_BRANCH=main

# Logging level
LOG_LEVEL=INFO

# Do NOT commit real secrets – copy this file to .env and fill in the values.
MEMORA_DATABASE_URL=sqlite:///data/memora.db
MEMORA_CORS_ORIGINS=*
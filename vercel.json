{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/frontend/app/api/$1/route.ts"
    },
    {
      "src": "/health",
      "dest": "/frontend/app/api/health/route.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "backend/app.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
